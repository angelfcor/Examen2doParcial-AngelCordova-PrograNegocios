<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="unicah_libro_view_list" model="ir.ui.view">
        <field name="name">unicah.libro.list</field>
        <field name="model">unicah.libro</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="autor"/>
                <field name="copias_totales"/>
                <field name="copias_disponibles"/>
            </list>
        </field>
    </record>

    <record id="unicah_libro_view_form" model="ir.ui.view">
        <field name="name">unicah.libro.form</field>
        <field name="model">unicah.libro</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="autor"/>
                        <field name="isbn"/>
                        <field name="copias_totales"/>
                        <field name="copias_disponibles"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="unicah_libro_action" model="ir.actions.act_window">
        <field name="name">Libros</field>
        <field name="res_model">unicah.libro</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="unicah_biblioteca_menu_root" name="Biblioteca" sequence="90"/>
    <menuitem id="unicah_libro_menu" name="Libros"
              parent="unicah_biblioteca_menu_root"
              action="unicah_libro_action" sequence="10"/>
</odoo>